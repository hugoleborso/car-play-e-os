<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Everything this app needs is a normal permission. There is no privileged
      permission, no platform signature and no ROM modification anywhere in the
      projection path. The virtual display is created with OWN_CONTENT_ONLY, which strips
      the permission-gated mirroring bit before the framework's check runs, and
      MediaCodec is unprivileged. See docs/04-android-integration.md.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: without it the car's microphone button simply does nothing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.usb.accessory" android:required="true" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!--
          The entry point is the head unit being plugged in, not the launcher.

          Android 15 forbids a BOOT_COMPLETED receiver from starting most
          foreground service types, so auto-starting at boot is not an option,
          and it would be the wrong design anyway. The accessory attach is a
          user-visible hardware event and is exactly when a session should begin.

          showOnLockScreen matters in practice: the phone is usually locked and
          in a dock when it is plugged into a car.
        -->
        <activity
            android:name=".UsbAttachActivity"
            android:exported="true"
            android:showOnLockScreen="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!--
          connectedDevice, not dataSync. dataSync is capped at six hours per
          twenty-four and calls onTimeout(), after which failing to stop
          promptly throws. connectedDevice has no time limit and is an accurate
          description of what this service does.
        -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
