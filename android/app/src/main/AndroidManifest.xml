<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Everything this app needs is a normal permission. There is no privileged
      permission, no platform signature and no ROM modification anywhere in the
      projection path. The virtual display is created with OWN_CONTENT_ONLY, which strips
      the permission-gated mirroring bit before the framework's check runs, and
      MediaCodec is unprivileged. See docs/04-android-integration.md.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: without it the car's microphone button simply does nothing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.usb.accessory" android:required="true" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!--
          The entry point is the head unit being plugged in, not the launcher.

          Android 15 forbids a BOOT_COMPLETED receiver from starting most
          foreground service types, so auto-starting at boot is not an option,
          and it would be the wrong design anyway. The accessory attach is a
          user-visible hardware event and is exactly when a session should begin.

          showOnLockScreen matters in practice: the phone is usually locked and
          in a dock when it is plugged into a car.
        -->
        <activity
            android:name=".UsbAttachActivity"
            android:exported="true"
            android:showOnLockScreen="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!--
          specialUse, and the reasoning is worth recording because the obvious
          choice does not work.

          connectedDevice describes exactly what this is. But from API 34 the
          platform gates each service type behind a permission set, and the set
          for connectedDevice is Bluetooth, Wi-Fi, NFC, infrared and UWB. There
          is no USB entry, because access to a USB accessory is granted per
          device at runtime rather than declared in a manifest. A projection
          service that talks over a cable and nothing else therefore cannot
          satisfy connectedDevice, and starting it anyway throws SecurityException
          at the moment the user plugs into the car.

          dataSync would pass the permission check and is the wrong answer for a
          different reason: it is capped at six hours per twenty-four and calls
          onTimeout(), after which failing to stop promptly throws. That ends a
          long drive badly.

          specialUse exists for cases the enumerated types do not cover, which
          this is. When the wireless transport lands the app will hold
          CHANGE_WIFI_STATE to join the head unit's access point, and at that
          point connectedDevice becomes both accurate and available.
        -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Projects the phone's display and audio to a car head unit over a USB accessory connection, for as long as the cable is connected." />
        </service>

    </application>

</manifest>
